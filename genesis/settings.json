{
    "minecraft_version": "1.21.6",
    "host": "192.168.1.190",
    "port": 25600,
    "auth": "offline",

    "mindserver_port": 8081,
    "mindserver_host": "0.0.0.0",
    "auto_open_ui": false,

    "init_message": "",
    "load_memory": true,

    "genesis_events": {
        "enabled": false,
        "redis_url": "redis://REDIS_HOST:6379",
        "stream": "genesis:events",
        "stream_per_agent": false,
        "stream_maxlen": 20000,
        "buffer_size": 2000
    },

    "genesis_planning": {
        "enabled": false,
        "operators": ["OPERATOR_NAME"],
        "world_file": "./genesis/genesis.world.json",
        "manifest_file": "./bots/genesis_world/bootstrap.manifest.json",
        "checkpoint_dir": "./bots/genesis_checkpoints",
        "ledger_file": "./bots/genesis_ledger/chest_ledger.json",
        "model": {
            "url": "http://DESKTOP_IP:11434",
            "model": "GENESIS_MODEL"
        },
        "postgres_url": ""
    },

    "genesis_recovery": {
        "enabled": true
    },

    "genesis_relay": {
        "enabled": true,
        "model_lines": true,
        "model_decisions": true,
        "decision": {
            "max_calls_per_hour": 20,
            "max_tokens": 80
        }
    },

    "allow_insecure_coding": false,
    "pathfinding_no_dig": true,
    "blocked_actions": [
        "!checkBlueprint",
        "!checkBlueprintLevel",
        "!getBlueprint",
        "!getBlueprintLevel",
        "!newAction",
        "!startConversation",
        "!endConversation"
    ],

    "profiles": [
        "./genesis/profiles/arthur.json",
        "./genesis/profiles/mira.json",
        "./genesis/profiles/felix.json",
        "./genesis/profiles/nova.json"
    ]
}
